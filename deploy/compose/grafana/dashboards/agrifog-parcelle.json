    },
    {
      "type": "stat",
      "title": "Besoin en eau du jour (ET0)",
      "description": "Évapotranspiration de référence (Hargreaves) : ce que l'air « boit » aujourd'hui.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(agrifog_et0_mm_per_day{fog=\"$fog\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthmm",
          "mappings": [],
