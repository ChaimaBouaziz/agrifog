{
  "uid": "agrifog-parcelle",
  "title": "AgriFog — Ma parcelle",
  "description": "La vue de l'agriculteur : état des plantes, eau utilisée, économies, et pourquoi le système arrose.",
  "tags": [
    "agrifog"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "fog",
        "label": "Fog",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(agrifog_moisture_threshold_pct, fog)",
          "refId": "fog"
        },
        "definition": "label_values(agrifog_moisture_threshold_pct, fog)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {},
        "options": [],
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "État des plantes, zone par zone",
      "description": "Humidité du sol comparée au seuil de stress de la culture : sous le seuil, la plante souffre ; moins de 2 points au-dessus, il faudra arroser bientôt.",
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (zone) (agrifog_soil_moisture_pct{fog=\"$fog\"}) - avg by (zone) (agrifog_moisture_threshold_pct{fog=\"$fog\"})",
          "legendFormat": "{{zone}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -100,
                "to": 0,
                "result": {
                  "text": "stress",
                  "color": "#d64545"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 2,
                "result": {
                  "text": "à surveiller",
                  "color": "#eb6834"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 2,
                "to": 100,
                "result": {
                  "text": "confort",
                  "color": "#3b9b5a"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b9b5a",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Économie d'eau sur la saison",
      "description": "Par rapport au meilleur arrosage à heure fixe qui évite tout stress (expérience 1, saison avril–septembre, météo réelle de Sfax).",
      "targets": [
        {
          "refId": "A",
          "expr": "-agrifog_season_saving_pct{fog=\"$fog\"}",
          "legendFormat": "",
