    {
      "type": "table",
      "title": "Problèmes en cours",
      "description": "Fuite, pompe en panne, capteur défectueux, capteur muet… Vide = tout va bien.",
      "targets": [
        {
          "refId": "A",
          "expr": "agrifog_alert_active{fog=\"$fog\"} == 1",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "fog": true
