        "x": 0,
        "y": 14,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "Arrosages des dernières 24 h (simulées)",
      "description": "Litres commandés par zone sur le dernier jour simulé (4 min réelles), à 20 L/min.",
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum by (zone) (increase(agrifog_water_commanded_seconds_total{fog=\"$fog\"}[4m])) / 60 * 20)",
          "legendFormat": "{{zone}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "litre",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2a78d6",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
