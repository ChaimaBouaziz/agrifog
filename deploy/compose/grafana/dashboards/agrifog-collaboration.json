{
  "uid": "agrifog-collaboration",
  "title": "AgriFog — Collaboration fog-a ↔ fog-b",
  "description": "Pont MQTT, présence du voisin, partage du quota d'eau et apprentissage fédéré.",
  "tags": [
    "agrifog"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ponts MQTT",
      "description": "État des ponts déclarés sur ce broker",
      "targets": [
        {
          "refId": "A",
          "expr": "agrifog_bridge_up",
          "legendFormat": "{{connection}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "connecté",
                  "color": "#3b9b5a"
                },
                "0": {
                  "text": "coupé",
                  "color": "#d64545"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d64545",
                "value": null
              },
              {
                "color": "#3b9b5a",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Dernier signe de vie de chaque fog (s)",
      "description": "Statut publié par chaque fog toutes les 10 s sur domaine/fog/<fog>/status (traverse le pont)",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - agrifog_fog_last_seen_timestamp_seconds",
          "legendFormat": "{{fog}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b9b5a",
                "value": null
              },
              {
                "color": "#eb6834",
                "value": 30
              },
              {
                "color": "#d64545",
                "value": 60
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Mode du quota",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "agrifog_quota_negotiated",
          "legendFormat": "{{fog}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "négocié",
                  "color": "#3b9b5a"
                },
                "0": {
                  "text": "isolé (50 %)",
                  "color": "#eb6834"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#eb6834",
                "value": null
              },
              {
                "color": "#3b9b5a",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Accord entre les fogs",
      "description": "Écart entre la répartition calculée par fog-a et celle calculée par fog-b (0 = accord, sans chef)",
      "targets": [
        {
          "refId": "A",
          "expr": "max((max by (fog) (agrifog_quota_allocation_liters) - min by (fog) (agrifog_quota_allocation_liters)) and on (fog) (count by (fog) (agrifog_quota_allocation_liters) == 2))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "accord ✓",
                  "color": "#3b9b5a"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.001,
                "to": 1000000000.0,
                "result": {
                  "text": "désaccord",
                  "color": "#d64545"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b9b5a",
                "value": null
              },
              {
                "color": "#d64545",
                "value": 1
              }
            ]
          },
          "noValue": "attend les 2 fogs"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "Répartition du quota du jour (vue de chaque fog)",
      "description": "Lecture : « fog-a → fog-b » = la part de fog-b calculée par fog-a. Chaque fog calcule seul : les barres doivent être identiques deux à deux.",
      "targets": [
        {
          "refId": "A",
          "expr": "agrifog_quota_allocation_liters",
          "legendFormat": "{{computed_by}} → {{fog}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "litre",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2a78d6",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Besoin annoncé chaque nuit",
      "description": "Besoin du jour publié à 3 h (simulées) sur domaine/quota/request",
      "targets": [
        {
          "refId": "A",
          "expr": "agrifog_quota_request_liters",
          "legendFormat": "{{fog}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "litre",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "drawStyle": "bars",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "fog-a.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "fog-b.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Quota de ce fog : attribué et utilisé",
      "description": "L'utilisé ne doit pas dépasser l'attribué. Le compteur repart à 0 chaque jour simulé.",
